<Project Sdk="Microsoft.NET.Sdk">
  <!-- Testes de compatibilidade com o FusionCore: inspecionam (sem executar o jogo) a NoVoteDeath.dll
       compilada e o interop do Among Us Android gerado pelo Il2CppInterop do FusionCore.
       Requer build/fetch-fusioncore.sh + build/gen-interop.sh + build do plugin (build/build.sh faz tudo). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <FusionCoreDir Condition="'$(FusionCoreDir)' == ''">$(MSBuildThisFileDirectory)../../.fusioncore</FusionCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FusionCoreDir</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(FusionCoreDir)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
